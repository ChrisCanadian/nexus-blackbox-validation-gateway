{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChrisCanadian/nexus-blackbox-validation-gateway/challenge.schema.json",
  "title": "Nexus Black-Box Challenge",
  "type": "object",
  "required": ["name", "provider", "steps"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "ttl_seconds": {"type": "integer", "minimum": 60, "maximum": 3600},
    "provider": {
      "type": "object",
      "required": ["base_url", "model"],
      "additionalProperties": false,
      "properties": {
        "base_url": {"type": "string", "pattern": "^https://"},
        "model": {"type": "string", "minLength": 1, "maxLength": 200},
        "supports_tools": {"type": "boolean"},
        "max_completion_tokens": {"type": "integer", "minimum": 1, "maximum": 65536}
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["artifact_type", "artifact"],
        "additionalProperties": false,
        "properties": {
          "artifact_type": {"const": "mode-card.v1"},
          "artifact": {"type": "object"}
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["message"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "maxLength": 200},
          "conversation_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,120}$"},
          "message": {"type": "string", "minLength": 1, "maxLength": 20000},
          "require_provider_route": {"type": "boolean"},
          "assertions": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "required": ["type", "value"],
              "additionalProperties": false,
              "properties": {
                "type": {"enum": ["contains", "not_contains", "equals", "starts_with"]},
                "value": {"type": "string", "maxLength": 20000}
              }
            }
          }
        }
      }
    }
  }
}
